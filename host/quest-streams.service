[Unit]
Description=Quest PipeWire capture, hardware H264 encoding and localhost transport
After=quest-displays.service
BindsTo=quest-displays.service
PartOf=quest-displays.service
StartLimitIntervalSec=900
StartLimitBurst=8

[Service]
Type=exec
ExecStart=%h/.local/libexec/quest-stream-launcher
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=5
RestartSteps=4
RestartMaxDelaySec=90
TimeoutStopSec=15
# Never leave the laptop screen off after streaming stops or crashes.
ExecStopPost=-%h/.local/libexec/quest-laptop-display on
